#!/bin/sh
# Refuse to push anything carrying a Claude conversation/session reference.
#
# WHY THIS EXISTS. This repository is PUBLIC. A session link is an immediate PII exposure the
# moment it lands here: transcripts can contain file paths, hostnames, device serials, MAC
# addresses, network addresses and personal details, and neither the link nor the transcript
# behind it can be reliably unpublished once it is indexed or cloned. Two such trailers reached
# origin/main before this hook existed.
#
# The private repo that feeds this one carried ~145 of them in its own history, so the sync from
# it is exactly the moment this would happen again. Remembering to check is not a control.
#
# Scope: only the commits actually being pushed are scanned, so pre-existing history does not
# block new work. Attribution (Co-Authored-By) is deliberately NOT matched - that carries no
# conversation reference and is fine to publish.
#
# MATCHING IS DELIBERATELY NARROW, and the first version got this wrong. It matched the bare
# words, which meant it matched ITS OWN SOURCE - the pattern definition below and the remediation
# command in the README - and refused to let itself be published. A guard that cannot be shipped
# is not a guard. So:
#   - a real trailer is matched only at the start of a line (that is where git puts it), and
#   - a real link is matched only WITH its session token, so prose and regexes that merely
#     discuss the policy do not trip it, and
#   - this hook's own files are excluded from the content scan outright.
#
# Bypass, if you ever genuinely need to: git push --no-verify

# A genuine trailer, anchored; or a genuine URL, which always carries a token after session_.
MSG_PATTERN='^[[:space:]]*Claude-Session:|claude\.ai/code/session_[A-Za-z0-9]|claude\.ai/chat/[A-Za-z0-9]'
SELF='ocbm/scripts/hooks/'
fail=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac        # deleting a ref: nothing to inspect
  case "$remote_sha" in
    *[!0]*) range="$remote_sha..$local_sha" ;;               # updating an existing branch
    *)      range="$local_sha" ;;                            # new branch: check all its commits
  esac

  hits=$(git log --format='%H %s%n%b' "$range" 2>/dev/null | grep -nE "$MSG_PATTERN")
  if [ -n "$hits" ]; then
    echo "pre-push: BLOCKED - a Claude session reference is present in a commit MESSAGE:" >&2
    echo "$hits" | sed 's/^/  /' >&2
    fail=1
  fi

  # Content, too: a session link pasted into a README or script is the same exposure. The hook's
  # own directory is excluded - it necessarily contains the pattern it searches for.
  files=$(git diff --name-only "$range" 2>/dev/null | grep -v "^$SELF" || true)
  if [ -n "$files" ]; then
    ctnt=$(git diff --no-color "$range" -- $files 2>/dev/null | grep -nE "^\+.*($MSG_PATTERN)")
    if [ -n "$ctnt" ]; then
      echo "pre-push: BLOCKED - a Claude session reference is present in added CONTENT:" >&2
      echo "$ctnt" | sed 's/^/  /' >&2
      fail=1
    fi
  fi
done

if [ "$fail" = 1 ]; then
  cat >&2 <<'EOF'

Nothing was pushed. To strip trailers from commit messages before publishing, run a
msg-filter over the range with git filter-branch, dropping lines that begin with the
trailer key. Then re-run the push. Use --no-verify only if you are certain.
EOF
  exit 1
fi
exit 0
